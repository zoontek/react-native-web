{
  "name": "react-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Nicolas Gallagher",
  "type": "module",
  "scripts": {
    "clean": "del-cli ./packages/*/dist",
    "build": "pnpm clean && pnpm --recursive --if-present build",
    "dev": "pnpm --recursive --if-present dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prerelease": "pnpm test && pnpm build",
    "release": "node ./scripts/releaseReactNativeWebPackages.ts",
    "release:benchmarks": "git checkout gh-pages && rm -rf ./docs/benchmarks && mv packages/benchmarks/dist ./docs/benchmarks && git add -A && git commit -m \"Deploy benchmarks\" && git push origin gh-pages && git checkout -",
    "release:react-native-web-docs": "git checkout gh-pages && rm -rf ./docs && mv packages/react-native-web-docs/dist ./docs && git add ./docs && git commit -m \"Deploy documentation\" && git push origin gh-pages && git checkout -",
    "postrelease": "pnpm release:react-native-web-docs && pnpm release:benchmarks",
    "prepare": "husky",
    "test": "pnpm typecheck && pnpm format && pnpm lint && pnpm unit",
    "unit": "vitest run",
    "unit:dom": "vitest run --project dom",
    "unit:node": "vitest run --project node",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
