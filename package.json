{
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "version": "0.0.0",
  "name": "react-ui-monorepo",
  "scripts": {
    "clean": "del-cli ./packages/*/dist",
    "build": "pnpm clean && pnpm --recursive --if-present build",
    "compile": "pnpm build",
    "dev": "pnpm --recursive --if-present dev",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prerelease": "pnpm test && pnpm build",
    "release": "node ./scripts/releaseReactNativeWebPackages.js",
    "release:benchmarks": "git checkout gh-pages && rm -rf ./docs/benchmarks && mv packages/benchmarks/dist ./docs/benchmarks && git add -A && git commit -m \"Deploy benchmarks\" && git push origin gh-pages && git checkout -",
    "release:react-native-web-docs": "git checkout gh-pages && rm -rf ./docs && mv packages/react-native-web-docs/dist ./docs && git add ./docs && git commit -m \"Deploy documentation\" && git push origin gh-pages && git checkout -",
    "postrelease": "pnpm release:react-native-web-docs && pnpm release:benchmarks",
    "prepare": "husky install configs/husky",
    "test": "pnpm typecheck && pnpm format && pnpm lint && pnpm unit --runInBand",
    "unit": "npm-run-all \"unit:* {@}\" --",
    "unit:dom": "jest --config ./configs/jest.config.js",
    "unit:node": "jest --config ./configs/jest.config.node.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "babel-jest": "^30.4.0",
    "babel-plugin-add-module-exports": "^1.0.4",
    "cross-env": "^7.0.3",
    "del-cli": "^4.0.1",
    "husky": "^8.0.0",
    "jest": "^30.4.0",
    "jest-environment-jsdom": "^30.4.0",
    "lint-staged": "^13.0.3",
    "minimist": "^1.2.6",
    "npm-run-all": "^4.1.3",
    "oxlint": "^1.77.0",
    "prettier": "^2.8.8",
    "typescript": "7.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "pnpm format:fix",
      "pnpm lint:fix"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none"
  },
  "author": "Nicolas Gallagher",
  "license": "MIT"
}
