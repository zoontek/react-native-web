{
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "name": "react-native-web",
  "version": "0.21.2",
  "description": "React Native for Web",
  "module": "dist/index.js",
  "main": "dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "scripts": {
    "clean": "del-cli ./dist",
    "build": "pnpm clean && pnpm build:types && pnpm build:es && pnpm build:commonjs",
    "build:commonjs": "cross-env BABEL_ENV=commonjs babel src --config-file ../../configs/babel.config.js --extensions \".ts,.tsx,.js,.jsx\" --out-dir dist/cjs --ignore \"**/__tests__\"",
    "build:es": "babel src --config-file ../../configs/babel.config.js --extensions \".ts,.tsx,.js,.jsx\" --out-dir dist --ignore \"**/__tests__\"",
    "build:types": "tsc --project tsconfig.build.json",
    "dev": "npm-run-all clean -p \"build:* {@} --watch\""
  },
  "dependencies": {
    "@react-native/normalize-colors": "^0.74.1",
    "fbjs": "^3.0.5",
    "memoize-one": "^6.0.0",
    "nullthrows": "^1.1.1",
    "postcss-value-parser": "^4.2.0",
    "styleq": "^0.1.3"
  },
  "devDependencies": {
    "dom-event-testing-library": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "author": "Nicolas Gallagher",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/necolas/react-native-web.git"
  },
  "tags": [
    "react"
  ],
  "keywords": [
    "react",
    "react-component",
    "react-native",
    "web"
  ]
}
