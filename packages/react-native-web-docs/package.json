{
  "private": true,
  "name": "react-native-web-docs",
  "version": "0.21.2",
  "description": "Documentation website for React Native for Web",
  "scripts": {
    "build:examples": "pnpm --filter react-native-web-examples build",
    "dev": "pnpm run build:examples && eleventy --serve",
